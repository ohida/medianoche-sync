{
	"name": "medianoche-sync",
	"version": "0.1.3",
	"description": "Use Medianoche RSS, web clipper, and read later articles in Obsidian with AI Summary, AI Comments, Star, Archive, and Delete.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"agent:validate": "node .agent/scripts/validate-agent-config.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"medianoche",
		"rss",
		"rss-reader",
		"web-clipper",
		"obsidian-web-clipper",
		"read-it-later",
		"read-later",
		"article-triage",
		"ai-summary",
		"ai-comments",
		"ai-perspectives",
		"ai-search",
		"semantic-search",
		"markdown",
		"frontmatter",
		"sync"
	],
	"author": "Takashi Ohida",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.10.0",
		"esbuild": "0.25.5",
		"obsidian": "1.12.3",
		"typescript": "^5.3.0"
	}
}
