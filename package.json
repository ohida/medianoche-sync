{
	"name": "medianoche-sync",
	"version": "0.1.6",
	"description": "Sync and triage article notes exported from Medianoche to your vault: RSS feeds, web clipper captures, read later articles, star, archive, delete, AI Summary, and AI Comments.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint .",
		"format": "prettier --write \"**/*.ts\"",
		"format:check": "prettier --check \"**/*.ts\"",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"medianoche",
		"rss",
		"rss-reader",
		"web-clipper",
		"obsidian-web-clipper",
		"read-it-later",
		"read-later",
		"article-triage",
		"ai-summary",
		"ai-comments",
		"ai-perspectives",
		"ai-search",
		"semantic-search",
		"markdown",
		"frontmatter",
		"sync"
	],
	"author": "Takashi Ohida",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.10.0",
		"@typescript-eslint/eslint-plugin": "^8.59.4",
		"@typescript-eslint/parser": "^8.59.4",
		"esbuild": "0.28.0",
		"eslint": "^10.4.0",
		"obsidian": "1.12.3",
		"prettier": "^3.8.3",
		"typescript": "^5.3.0",
		"vitest": "^4.1.7"
	}
}
