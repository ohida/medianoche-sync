{
	"name": "medianoche-sync",
	"version": "0.1.2",
	"description": "Obsidian plugin for Medianoche article triage (Star/Archive/Delete)",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"agent:validate": "node .agent/scripts/validate-agent-config.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": ["obsidian", "plugin", "medianoche", "read-later"],
	"author": "Takashi Ohida",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.10.0",
		"esbuild": "0.25.5",
		"obsidian": "1.12.3",
		"typescript": "^5.3.0"
	}
}
